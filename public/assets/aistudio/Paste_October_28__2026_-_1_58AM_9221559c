enum class IdiomaDestino(val codigo: String, val nombreDisplay: String, val esOffline: Boolean) {
    ESPANOL("es", "Español", true),
    CHINO_MANDARIN("zh", "中文 (Mandarín)", true),
    RUSO("ru", "Русский (Ruso)", true),
    DANES("da", "Dansk (Danés)", true),
    MAYA_KICHE("quc", "K'iche'", false),
    MAYA_QEQCHI("kek", "Q'eqchi'", false),
    MAYA_KAQCHIKEL("cak", "Kaqchikel", false),
    GARIFUNA("cab", "Garífuna", false)
}

object TraductorUniversalManager {
    private var geminiModel: GenerativeModel? = null
    private val cacheTraducciones = mutableMapOf<String, String>()
    private var translatorActual: Translator? = null
    private var idiomaActualMLKit: String? = null

    fun inicializar(geminiApiKey: String) {
        geminiModel = GenerativeModel(modelName = "gemini-1.5-flash", apiKey = geminiApiKey)
    }

    suspend fun traducir(texto: String, idioma: IdiomaDestino): String = withContext(Dispatchers.IO) {
        if (texto.isBlank() || idioma == IdiomaDestino.ESPANOL) return@withContext texto
        val clave = "${idioma.codigo}_$texto"
        cacheTraducciones[clave]?.let { return@withContext it }

        val res = if (idioma.esOffline) {
            traducirOfflineMLKit(texto, idioma)
        } else {
            traducirOnlineGemini(texto, idioma)
        }
        cacheTraducciones[clave] = res
        return@withContext res
    }

    private suspend fun traducirOfflineMLKit(texto: String, idioma: IdiomaDestino): String {
        return try {
            val target = when (idioma) {
                IdiomaDestino.CHINO_MANDARIN -> TranslateLanguage.CHINESE
                IdiomaDestino.RUSO -> TranslateLanguage.RUSSIAN
                IdiomaDestino.DANES -> TranslateLanguage.DANISH
                else -> TranslateLanguage.ENGLISH
            }

            if (translatorActual == null || idiomaActualMLKit != target) {
                translatorActual?.close()
                val options = TranslatorOptions.Builder()
                    .setSourceLanguage(TranslateLanguage.SPANISH)
                    .setTargetLanguage(target)
                    .build()
                translatorActual = Translation.getClient(options)
                idiomaActualMLKit = target
                translatorActual?.downloadModelIfNeeded(DownloadConditions.Builder().build())?.await()
            }
            translatorActual?.translate(texto)?.await() ?: texto
        } catch (e: Exception) {
            texto
        }
    }

    private suspend fun traducirOnlineGemini(texto: String, idioma: IdiomaDestino): String {
        return try {
            val prompt = "Traduce del español al idioma originario ${idioma.nombreDisplay} de forma natural, sin notas ni comillas:\n$texto"
            geminiModel?.generateContent(prompt)?.text?.trim() ?: texto
        } catch (e: Exception) {
            texto
        }
    }
}

