@Entity(tableName = "lecturas_familia")
data class LecturaFamiliaEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val categoria: String,
    val titulo: String,
    val contenido: String
)

@Entity(tableName = "tareas_rutina")
data class TareaEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val descripcion: String,
    val completada: Boolean = false,
    val fechaCreacion: Long = System.currentTimeMillis()
)

@Dao
interface LecturaFamiliaDao {
    @Query("SELECT * FROM lecturas_familia")
    suspend fun obtenerTodas(): List<LecturaFamiliaEntity>

    @Query("SELECT * FROM lecturas_familia WHERE categoria = :cat LIMIT 1")
    suspend fun obtenerPorCategoria(cat: String): LecturaFamiliaEntity?

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertarTodas(lecturas: List<LecturaFamiliaEntity>)
}

@Dao
interface TareaDao {
    @Query("SELECT * FROM tareas_rutina WHERE completada = 0 ORDER BY id DESC")
    suspend fun obtenerTareasPendientes(): List<TareaEntity>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertarTarea(tarea: TareaEntity)

    @Query("UPDATE tareas_rutina SET completada = 1 WHERE id = :tareaId")
    suspend fun marcarComoCompletada(tareaId: Int)
}

