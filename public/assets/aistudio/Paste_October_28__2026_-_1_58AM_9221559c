// 6. ADMINISTRADOR DE VOZ ROBUSTO (NO SE TRABA EN ROJO)
// ============================================================================

class VozManager(
    private val context: Context,
    private val iconoMic: ImageView,
    private val onTextoEscuchado: (String) -> Unit
) {
    private var speechRecognizer: SpeechRecognizer? = null
    private val mainHandler = Handler(Looper.getMainLooper())

    init {
        mainHandler.post {
            if (SpeechRecognizer.isRecognitionAvailable(context)) {
                speechRecognizer = SpeechRecognizer.createSpeechRecognizer(context).apply {
                    setRecognitionListener(crearListener())
                }
            }
        }
    }

    fun empezarAEscuchar() {
        mainHandler.post {
            try {
                iconoMic.setColorFilter(Color.parseColor("#4CAF50")) // Verde: Escuchando
                val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                    putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                    putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.getDefault())
                }
                speechRecognizer?.startListening(intent)
            } catch (e: Exception) {
                resetearMic()
            }
        }
    }

    fun resetearMic() {
        iconoMic.setColorFilter(Color.parseColor("#757575")) // Reposo
    }

    private fun crearListener() = object : RecognitionListener {
        override fun onResults(results: Bundle?) {
            val match = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull()
            if (!match.isNullOrBlank()) onTextoEscuchado(match)
            resetearMic()
        }

        override fun onError(error: Int) {
            iconoMic.setColorFilter(Color.parseColor("#E53935")) // Rojo transitorio
            mainHandler.postDelayed({ resetearMic() }, 600)
        }

        override fun onReadyForSpeech(params: Bundle?) {}
        override fun onBeginningOfSpeech() {}
        override fun onRmsChanged(rmsdB: Float) {}
        override fun onBufferReceived(buffer: ByteArray?) {}
        override fun onEndOfSpeech() { resetearMic() }
        override fun onPartialResults(partialResults: Bundle?) {}
        override fun onEvent(eventType: Int, params: Bundle?) {}
    }

    fun destruir() { speechRecognizer?.destroy() }
}

