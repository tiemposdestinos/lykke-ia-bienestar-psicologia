        setContentView(layout)

        // Animación de desfragmentación / expansión en grande
        layout.scaleX = 0.2f
        layout.scaleY = 0.2f
        layout.alpha = 0f
        layout.animate()
            .scaleX(1f)
            .scaleY(1f)
            .alpha(1f)
            .setInterpolator(AnticipateOvershootInterpolator(1.2f))
            .setDuration(500)
            .start()
    }
}

