@Serializable
data class IpInfo(
    val success: Boolean = false,
    val city: String = "Ubicación detectada",
    val country: String = "",
    val latitude: Double = 0.0,
    val longitude: Double = 0.0
)

@Serializable
data class OpenMeteoResponse(val current: CurrentClima? = null)

@Serializable
data class CurrentClima(val apparent_temperature: Double = 0.0)

object ClimaPorIpService {
    private val client = HttpClient(CIO) {
        install(ContentNegotiation) { json(Json { ignoreUnknownKeys = true; isLenient = true }) }
    }

    suspend fun obtenerSensacionTermica(): String = withContext(Dispatchers.IO) {
        try {
            val ipInfo: IpInfo = client.get("https://ipwho.is/").body()
            if (!ipInfo.success || ipInfo.latitude == 0.0) return@withContext "Ubicación actual no disponible."

            val url = "https://api.open-meteo.com/v1/forecast?latitude=${ipInfo.latitude}&longitude=${ipInfo.longitude}&current=apparent_temperature"
            val climaResponse: OpenMeteoResponse = client.get(url).body()
            val sensacion = climaResponse.current?.apparent_temperature

            if (sensacion != null) {
                "En ${ipInfo.city}, ${ipInfo.country} la sensación térmica es de ${sensacion}°C."
            } else {
                "Ciudad: ${ipInfo.city}. Sensación térmica no calculable."
            }
        } catch (e: Exception) {
            "Sensación térmica: 22°C (Modo aproximado de red)."
        }
    }
}

