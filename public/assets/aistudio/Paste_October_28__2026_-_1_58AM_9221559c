@Serializable
data class BaiduTokenResponse(val access_token: String? = null)

class BaiduSearchClient(private val apiKey: String, private val secretKey: String) {
    private val client = HttpClient(CIO) {
        install(ContentNegotiation) { json(Json { ignoreUnknownKeys = true; isLenient = true }) }
    }
    private var tokenCached: String? = null

    private suspend fun getAccessToken(): String {
        tokenCached?.let { return it }
        val oauthUrl = "https://aip.baidubce.com/oauth/2.0/token"
        val resp: BaiduTokenResponse = client.get(oauthUrl) {
            parameter("grant_type", "client_credentials")
            parameter("client_id", apiKey)
            parameter("client_secret", secretKey)
        }.body()
        return resp.access_token?.also { tokenCached = it } ?: throw IllegalStateException("Token no generado")
    }

    suspend fun search(query: String): String = withContext(Dispatchers.IO) {
        try {
            val token = getAccessToken()
            val url = "https://qianfan.baidubce.com/v2/ai_search/chat/completions"
            val payload = JSONObject().apply {
                put("messages", JSONArray().put(JSONObject().put("role", "user").put("content", query)))
                put("stream", false)
            }
            val res: HttpResponse = client.post(url) {
                parameter("access_token", token)
                contentType(ContentType.Application.Json)
                setBody(payload.toString())
            }
            res.bodyAsText()
        } catch (e: Exception) {
            "Error en búsqueda Baidu: ${e.message}"
        }
    }
}

