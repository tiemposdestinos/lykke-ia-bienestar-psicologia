    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        prefs = PreferenciasPersistentes(this)
        db = AppDatabase.getDatabase(this, lifecycleScope)
        TraductorUniversalManager.inicializar("TU_GEMINI_API_KEY")

        // Solicitar permisos de audio y notificaciones
        val permisos = mutableListOf(Manifest.permission.RECORD_AUDIO)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            permisos.add(Manifest.permission.POST_NOTIFICATIONS)
        }
        requestPermisos.launch(permisos.toTypedArray())

        // Construcción de interfaz translúcida (Marca de Agua) en código
        val rootLayout = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(32, 48, 32, 32)
            setBackgroundColor(Color.parseColor("#15000000")) // Fondo marca de agua muy suave
        }

        edtNombreIA = EditText(this).apply {
            hint = "Nombre de la IA"
            setText(prefs.nombreIA)
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            doAfterTextChanged { prefs.nombreIA = it.toString() }
        }

        edtNombreUsuario = EditText(this).apply {
            hint = "¿Cómo deseas que te llame?"
            setText(prefs.nombreUsuario)
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            doAfterTextChanged { prefs.nombreUsuario = it.toString() }
        }

        edtTarea = EditText(this).apply {
            hint = ClaveRecordatorioManager.obtenerInstruccion()
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
        }

        btnMicrofono = ImageView(this).apply {
            setImageResource(android.R.drawable.ic_btn_speak_now)
            setColorFilter(Color.parseColor("#757575"))
            setPadding(16, 16, 16, 16)
        }

        txtConsola = TextView(this).apply {
            text = "¡Qué gusto saludarte! En qué puedo acompañarte hoy."
            setTextColor(Color.parseColor("#1A1A1A"))
            textSize = 15f
            setTypeface(null, android.graphics.Typeface.BOLD)
            setPadding(16, 24, 16, 24)
        }

        btnRegalo = Button(this).apply {
            text = "🎁 Abrir Regalo Diario"
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            setBackgroundColor(Color.parseColor("#33FFFFFF")) // Marca de agua
            setOnClickListener { RegaloAmorPropioDialog(this@MainActivity, prefs).show() }
        }

        btnLecturas = Button(this).apply {
            text = "📖 Lectura de Familia y Perdón"
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            setBackgroundColor(Color.parseColor("#33FFFFFF")) // Marca de agua
            setOnClickListener { cargarLecturaFamilia() }
        }

        btnBuscador = Button(this).apply {
            text = "🌐 Buscar con Baidu / Red"
            setTextColor(Color.parseColor("#1A1A1A"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            setBackgroundColor(Color.parseColor("#33FFFFFF")) // Marca de agua
            setOnClickListener {
                val q = edtTarea.text.toString()
                if (q.isNotBlank()) ejecutarBusqueda(q)
            }
        }

        // Ensamblar vistas
        rootLayout.addView(edtNombreIA)
        rootLayout.addView(edtNombreUsuario)
        rootLayout.addView(edtTarea)
        rootLayout.addView(btnMicrofono)
        rootLayout.addView(btnRegalo)
        rootLayout.addView(btnLecturas)
        rootLayout.addView(btnBuscador)
        rootLayout.addView(txtConsola)
        setContentView(rootLayout)

        // Inicializar Gestor de Voz seguro
        vozManager = VozManager(this, btnMicrofono) { textoVoz ->
            procesarEntradaTextoOVoz(textoVoz)
        }
        btnMicrofono.setOnClickListener { vozManager.empezarAEscuchar() }

        // Programar Tareas en Segundo Plano
        programarTrabajadores()
    }

    private fun procesarEntradaTextoOVoz(entrada: String) {
        val saludo = "¡Qué gusto saludarte! "
        if (entrada.startsWith("anota", ignoreCase = true) || entrada.startsWith("recordar", ignoreCase = true)) {
            val tareaLimpia = entrada.replaceFirst("(?i)anota|recordar".toRegex(), "").trim()
            lifecycleScope.launch(Dispatchers.IO) {
                db.tareaDao().insertarTarea(TareaEntity(descripcion = tareaLimpia))
                withContext(Dispatchers.Main) {
                    txtConsola.text = "$saludo He registrado en tu rutina: \"$tareaLimpia\"."
                }
            }
        } else {
            txtConsola.text = "$saludo He escuchado: \"$entrada\"."
        }
    }

    private fun cargarLecturaFamilia() {
        lifecycleScope.launch {
            val lectura = withContext(Dispatchers.IO) {
                db.lecturaFamiliaDao().obtenerPorCategoria("HERMANDAD")
            }
            if (lectura != null) {
                // Traduce al idioma actual seleccionado (Ejemplo: K'iche' o Chino)
                val tituloTraducido = TraductorUniversalManager.traducir(lectura.titulo, IdiomaDestino.MAYA_KICHE)
                val contenidoTraducido = TraductorUniversalManager.traducir(lectura.contenido, IdiomaDestino.MAYA_KICHE)
                txtConsola.text = "📚 $tituloTraducido\n\n$contenidoTraducido"
            }
        }
    }

    private fun ejecutarBusqueda(query: String) {
        lifecycleScope.launch {
            txtConsola.text = "Consultando redes..."
            val resultado = baiduClient.search(query)
            txtConsola.text = "Resultado:\n$resultado"
        }
    }

    private fun programarTrabajadores() {
        val workManager = WorkManager.getInstance(this)

        val reqClimaRutina = PeriodicWorkRequestBuilder<RutinaYClimaWorker>(5, TimeUnit.HOURS).build()
        workManager.enqueueUniquePeriodicWork("RutinaYClima5h", ExistingPeriodicWorkPolicy.KEEP, reqClimaRutina)

        val reqCapsulas = PeriodicWorkRequestBuilder<CapsulasWorker>(4, TimeUnit.HOURS).build()
        workManager.enqueueUniquePeriodicWork("Capsulas4h", ExistingPeriodicWorkPolicy.KEEP, reqCapsulas)

        val reqTerapias = PeriodicWorkRequestBuilder<TerapiasWorker>(3, TimeUnit.DAYS).build()
        workManager.enqueueUniquePeriodicWork("Terapias3d", ExistingPeriodicWorkPolicy.KEEP, reqTerapias)
    }

    override fun onDestroy() {
        super.onDestroy()
        vozManager.destruir()
    }
}