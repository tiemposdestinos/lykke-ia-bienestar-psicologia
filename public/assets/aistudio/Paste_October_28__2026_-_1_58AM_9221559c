class MainActivity : AppCompatActivity() {

    private lateinit var prefs: PreferenciasPersistentes
    private lateinit var vozManager: VozManager
    private lateinit var db: AppDatabase
    private val baiduClient = BaiduSearchClient("TU_BAIDU_AK", "TU_BAIDU_SK")

    // Vistas principales
    private lateinit var edtNombreIA: EditText
    private lateinit var edtNombreUsuario: EditText
