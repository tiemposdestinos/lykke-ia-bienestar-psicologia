rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.adminNotificationEmail is string && data.adminNotificationEmail.size() <= 100 &&
             data.syncStatus is string && data.syncStatus.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.lastLoginAt is timestamp && data.lastLoginAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'adminNotificationEmail', 'syncStatus', 'createdAt', 'lastLoginAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'adminNotificationEmail', 'syncStatus', 'createdAt', 'lastLoginAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'adminNotificationEmail', 'syncStatus', 'createdAt', 'lastLoginAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'adminNotificationEmail', 'syncStatus', 'createdAt', 'lastLoginAt']) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId;

      allow delete: if false;
    }
  }
}
