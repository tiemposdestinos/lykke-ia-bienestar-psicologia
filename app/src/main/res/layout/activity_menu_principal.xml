<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Encabezado en Azul Platinado & Amarillo Dorado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asesorías Consultorias psicología"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LivsForm Lykke • Entorno seguro, confidencial y encriptado"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- 1. Botón Principal Unificado: Club de Consultoría Ilimitada (Marco en Azul Platinado) -->
        <LinearLayout
            android:id="@+id/btnClubConsultoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_azul_platinado"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ Club de Consultoría Ilimitada"
                    android:textColor="#FFD54F"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESO EXCLUSIVO"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca aquí para acceder a tu Diario Seguro o al Chat de Desahogo. Incluye contador compartido de 5 usos o pase vitalicio."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 2. Botón: Insignias y Diplomas (Marco en Azul Platinado) -->
        <LinearLayout
            android:id="@+id/btnInsigniasDiplomas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_azul_platinado"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Insignias y Diplomas"
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trámite oficial de tu certificado de avance por correo."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 3. Botón: Aportación Voluntaria Libre (SOBRESALE con otro color y FRANJAS DE AMISTAD) -->
        <LinearLayout
            android:id="@+id/btnDonarSoporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_donaciones_amistad"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Franjas visuales decorativas de amistad en el cuadro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FBBF24" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#F472B6" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#A78BFA" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#38BDF8" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#34D399" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FB923C" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="❤️ Aportación Voluntaria Libre"
                    android:textColor="#F472B6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤝 AMISTAD &amp; SOLIDARIDAD"
                    android:textColor="#FFD54F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu apoyo económico voluntario está destinado exclusivamente al soporte técnico, mantenimiento de servidores y el financiamiento para el desarrollo de futuras herramientas gratuitas dentro de esta plataforma."
                android:textColor="#FCE7F3"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <!-- Franja inferior de cierre de amistad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#38BDF8" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#34D399" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FBBF24" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#F472B6" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Botón: Canjear Clave de Activación -->
        <Button
            android:id="@+id/btnCanjearCodigo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔑 Canjear Clave de Activación"
            android:textColor="#0F172A"
            android:backgroundTint="#FFD54F"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Logo en pequeño de LivsForm Lykke al final (Marco en Azul Platinado) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_azul_platinado"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivLogoLivsform"
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_livsform_logo"
                android:contentDescription="Logo LivsForm Lykke"
                android:background="#FFFFFF"
                android:padding="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LivsForm Lykke"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asesorías Consultorias psicología"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tiemposdestinos@gmail.com"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
